{
  "name": "Org Config Repo Admins Only",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "repository_name": {
      "include": [
        ".github"
      ],
      "exclude": []
    },
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": []
    }
  },
  "rules": [
    { "type": "creation" },
    { "type": "update" },
    { "type": "deletion" },
    { "type": "non_fast_forward" }
  ],
  "bypass_actors": [
    { "actor_id": null, "actor_type": "OrganizationAdmin", "bypass_mode": "always" }
  ]
}
